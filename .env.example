# FAE-v2 environment variables
# Copy to .env and fill in real values. .env is gitignored.

# === Always-on Core (P6 / Telegram) — REQUIRED on resident machine ===
# Use with: ./deploy/scripts/start-core.sh  (docker-compose.core.yml)
# Telegram / proactive Loop / browser chat (P7) use these server keys.
# Browser localStorage Key is an optional override only.
# LETTA_MODE=embedded
# SCHEDULER_ENABLED=true
# DASHSCOPE_API_KEY=
# # or:
# # PROACTIVE_LLM_API_KEY=
# # PROACTIVE_LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# # PROACTIVE_LLM_MODEL=qwen3-max
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
# TELEGRAM_ENABLED=true
# Optional personal client token (Tailscale / remote Core recommended):
# FAE_CLIENT_TOKEN=
# UI: NEXT_PUBLIC_FAE_CLIENT_TOKEN=  (or Settings → Models local override)
# See doc/operations/DEPLOY.md for the 30-minute checklist and Tailscale notes.

# ── App ───────────────────────────────────────────────────────────────
APP_ENV=development
LOG_LEVEL=INFO

# ── Local TTS only (no cloud / browser TTS) ───────────────────────────
# npm run dev starts Qwen3-TTS on :8880 (scripts/tts/run.sh). First setup: npm run setup:tts
# Apple Silicon: MLX 8bit backend, TTS_MAX_CONCURRENT=2 (see doc/operations/LOCAL_TTS.md)
# UI → FAE :8000/api/tts/speak → {VLLM_TTS_URL}/audio/speech
VLLM_TTS_URL=http://127.0.0.1:8880/v1
TTS_MODEL=tts-1
TTS_VOICE=Vivian
TTS_LANGUAGE=Chinese
TTS_SPEED=1.0
TTS_SAMPLE_RATE=24000
TTS_RESPONSE_FORMAT=wav
TTS_TIMEOUT_S=300
# Optional overrides for scripts/tts/run.sh:
# TTS_BACKEND=mlx
# MLX_MODEL_ID=mlx-community/Qwen3-TTS-12Hz-1.7B-CustomVoice-bf16
# Faster / sandier: mlx-community/Qwen3-TTS-12Hz-1.7B-CustomVoice-8bit
# TTS_MAX_CONCURRENT=1
# Optional China HF mirror for first weight download:
# HF_ENDPOINT=https://hf-mirror.com


# OpenAI-compatible chat endpoint (UI Settings can override per model)
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL=qwen3-max
# Optional LLM key (chat only — not used for TTS):
# DASHSCOPE_API_KEY=


# ── Letta (long-term memory) ──────────────────────────────────────────
# remote = HTTP to Letta server (compose service `letta`)
# embedded = local SQLite under .data/fae-memory.db (no Docker Letta; good for M2-1 offline)
# Prefer embedded for local M2-1 without pulling letta/letta; use remote with compose.
# Local default: embedded SQLite. Compose backend overrides to remote.
LETTA_MODE=embedded
LETTA_SERVER_URL=http://localhost:8283
LETTA_AGENT_NAME=fae-main
# LETTA_SERVER_PASSWORD=
# LETTA_EMBEDDED_PATH=.data/fae-memory.db
# Shared hot-window recall (SQLite) + compaction into Qdrant fae_archival
# RECALL_DB_PATH=.data/fae-recall.db
# RECALL_MAX_TURNS=30
# RECALL_COMPACT_BATCH=10
# CORE_CURRENT_CHAR_LIMIT=2000
# ARCHIVAL_PREFER_STUB=false
# ARCHIVAL_DECAY_DAYS=180
# Optional OpenAI-compatible embeddings for archival (empty = hash stub vectors)
# EMBEDDING_BASE_URL=https://api.openai.com/v1
# EMBEDDING_API_KEY=
# EMBEDDING_MODEL=text-embedding-3-small
# EMBEDDING_DIMENSIONS=0
# EPISODIC_DB_PATH=.data/fae-episodic.db
# Sleeptime consolidation (idle summarize → core/facts)
# SLEEPTIME_ENABLED=true
# SLEEPTIME_IDLE_SECONDS=300
# SLEEPTIME_POLL_SECONDS=30
# SLEEPTIME_MAX_RUNTIME_S=30
# SLEEPTIME_MIN_INTERVAL_S=60
# SLEEPTIME_DAILY_HOUR=3

# ── Context Engineering (see doc/design/CONTEXT_ENGINEERING.md) ────────────
# R2 rolling summary (on by default)
# ROLLING_SUMMARY_ENABLED=true
# ROLLING_SUMMARY_MAX_TURNS=30
# ROLLING_SUMMARY_MAX_CHARS=9000
# ROLLING_SUMMARY_RECENT_KEEP=6
# ROLLING_SUMMARY_TIMEOUT_S=20
# R3 Daily path LLMContextSummarizer (opt-in)
# DAILY_CONTEXT_SUMMARY_ENABLED=false
# DAILY_CONTEXT_MAX_TOKENS=8000
# DAILY_CONTEXT_TARGET_TOKENS=4000
# DAILY_CONTEXT_RECENT_MESSAGES=4
# R4 Letta-style reflection subagent (on by default)
# REFLECTION_ENABLED=true
# REFLECTION_MAX_TASK_CHARS=6000
# REFLECTION_TIMEOUT_S=20
# R5 tool-result offload (on by default)
# TOOL_OFFLOAD_ENABLED=true
# TOOL_OFFLOAD_CHARS=8000
# TOOL_OFFLOAD_DIR=.data/tool-offload
# TOOL_OFFLOAD_KEEP_LINES=20
# TOOL_OFFLOAD_TTL_S=86400         # seconds; reaped on next sweep
# TOOL_OFFLOAD_CLEANUP_INTERVAL_S=300  # background sweep period
# R6 Contextual Retrieval (opt-in — pays off on Anthropic endpoints)
# CONTEXTUAL_RETRIEVAL_ENABLED=false
# CONTEXTUAL_RETRIEVAL_CHARS=160

# ── vLLM self-hosted (optional — for fully local mode) ───────────────
VLLM_ASR_URL=http://localhost:8001
VLLM_LLM_URL=http://localhost:8002

# ── Vector store ──────────────────────────────────────────────────────
QDRANT_URL=http://localhost:6333

# ── Redis ─────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── Chat history (recent turns) — independent of long-term memory ─────
# CHAT_HISTORY_DB_PATH=.data/fae-chat-history.db
# CHAT_HISTORY_RETENTION_DAYS=7
# CHAT_HISTORY_CLEANUP_INTERVAL_S=3600

# ── Tool audit log ─────────────────────────────────────────────────────
# TOOL_AUDIT_DB_PATH=.data/fae-tool-audit.db
# ── Agent execution trace (process sequence per turn) ────────────────
# AGENT_TRACE_DB_PATH=.data/fae-agent-trace.db
# ── Persistent task state machine (queued/running/needs_input/...) ────
# TASK_DB_PATH=.data/fae-tasks.db
# ── Sensitive / dangerous op approval flow (P1) ───────────────────────
# APPROVALS_DB_PATH=.data/fae-approvals.db
# APPROVAL_DEFAULT_TTL_S=60.0
# APPROVAL_DANGEROUS_TTL_S=30.0
# APPROVAL_DOUBLE_CONFIRM_WINDOW_S=5.0

# ── CORS (Next.js UI origins, comma-separated) ────────────────────────
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001

# ── Next.js UI (copy into ui/.env.local if needed) ────────────────────
# NEXT_PUBLIC_API_URL=http://localhost:8000
# NEXT_PUBLIC_LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# NEXT_PUBLIC_LLM_MODEL=qwen3-max

# LLM_TIMEOUT_S=60

# ── Skills (Phase 3) ─────────────────────────────────────────────────
SKILLS_ENABLED=true
# SKILLS_DIR=                 # default: backend/src/skills
# SKILLS_STATE_PATH=.data/fae-skills-state.json
# SKILLS_MAX_ACTIVE=2

# ── Live weather (Open-Meteo, no API key) ─────────────────────────────
WEATHER_ENABLED=true
# Optional fallbacks if the user has not saved City / Timezone in Settings
# WEATHER_DEFAULT_CITY=北京
# WEATHER_DEFAULT_TIMEZONE=Asia/Shanghai

# ── Coding tools (workspace sandbox) ───────────────────────────────────
# All coding tools remain disabled until a workspace root is configured.
# CODING_WORKSPACE_ROOT=/absolute/path/to/project
# CODING_FILESYSTEM_ENABLED=false
# CODING_BASH_ENABLED=false
# CODING_GIT_ENABLED=false
# CODING_BASH_TIMEOUT_S=30
# CODING_GIT_TIMEOUT_S=20

# ── Proactive scheduler (Phase 4 / Q.4) ───────────────────────────────
# Settings default is false if unset; set true for local demos.
SCHEDULER_ENABLED=true
# HEARTBEAT_SECONDS=30
# OUTREACH_IDLE_HOURS=6
# OUTREACH_COOLDOWN_HOURS=12
# OUTREACH_MAX_PER_DAY=1
# SCHEDULES_DB_PATH=.data/fae-schedules.db
# NOTIFICATIONS_ENABLED=true
# Server-side LLM for proactive Loop (falls back to DASHSCOPE_API_KEY).
# Does NOT read browser localStorage model keys.
# PROACTIVE_LLM_API_KEY=
# PROACTIVE_LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# PROACTIVE_LLM_MODEL=qwen3-max
# Web Push (optional). Generate with:
#   python -c "from py_vapid import Vapid01; v=Vapid01(); v.generate_keys(); print(v.public_key); print(v.private_key)"
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:fae@localhost

# ── Daily (optional WebRTC only — not required for local TTS)
DAILY_API_KEY=

# ── Telegram channel (Phase 5.1, optional) ────────────────────────────
# Long polling — no public HTTPS URL required. Shares memory session_id=default.
# Uses the same server LLM as proactive Loop (PROACTIVE_LLM_* / DASHSCOPE_API_KEY).
# TELEGRAM_ENABLED=true
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=

# ── Subagents (Phase 5.2) ─────────────────────────────────────────────
# Tool run_subagent attaches only when an active skill requires it
# (e.g. research_delegate). Nested subagents are disabled.
# SUBAGENT_ENABLED=true
# SUBAGENT_TIMEOUT_S=60

# ── Security ──────────────────────────────────────────────────────────
SECRET_KEY=change-me
