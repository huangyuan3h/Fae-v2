# FAE-v2 environment variables
# Copy to .env and fill in real values. .env is gitignored.

# ── App ───────────────────────────────────────────────────────────────
APP_ENV=development
LOG_LEVEL=INFO

# ── DashScope (Qwen3-TTS Realtime + Qwen3 LLM) ───────────────────────
# Get one at https://dashscope.console.aliyun.com/
DASHSCOPE_API_KEY=

# OpenAI-compatible chat endpoint (DashScope compatible-mode by default)
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL=qwen3-max


# ── Letta (long-term memory) ──────────────────────────────────────────
LETTA_SERVER_URL=http://localhost:8283

# ── vLLM self-hosted (optional — for fully local mode) ───────────────
VLLM_ASR_URL=http://localhost:8001
VLLM_LLM_URL=http://localhost:8002

# ── Vector store ──────────────────────────────────────────────────────
QDRANT_URL=http://localhost:6333

# ── Redis ─────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── CORS (Next.js UI origins, comma-separated) ────────────────────────
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ── Daily (optional WebRTC — enables Pipecat Silero/SmartTurn/TTS path)
DAILY_API_KEY=

# TTS voice (DashScope qwen3-tts-flash)
# DASHSCOPE_API_KEY above is reused for TTS when set


# ── Security ──────────────────────────────────────────────────────────
SECRET_KEY=change-me
