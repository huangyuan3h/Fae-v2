# FAE-v2 environment variables
# Copy to .env and fill in real values. .env is gitignored.

# ── App ───────────────────────────────────────────────────────────────
APP_ENV=development
LOG_LEVEL=INFO

# ── Local TTS only (no cloud / browser TTS) ───────────────────────────
# npm run dev starts Qwen3-TTS on :8880 (scripts/tts/run.sh). First setup: npm run setup:tts
# UI → FAE :8000/api/tts/speak → {VLLM_TTS_URL}/audio/speech
# See doc/LOCAL_TTS.md
VLLM_TTS_URL=http://127.0.0.1:8880/v1
TTS_MODEL=tts-1
TTS_VOICE=Vivian
TTS_LANGUAGE=Chinese
TTS_SPEED=1.2
TTS_SAMPLE_RATE=24000
TTS_RESPONSE_FORMAT=wav
TTS_TIMEOUT_S=300
# Optional China HF mirror for first weight download:
# HF_ENDPOINT=https://hf-mirror.com


# OpenAI-compatible chat endpoint (UI Settings can override per model)
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL=qwen3-max
# Optional LLM key (chat only — not used for TTS):
# DASHSCOPE_API_KEY=


# ── Letta (long-term memory) ──────────────────────────────────────────
# remote = HTTP to Letta server (compose service `letta`)
# embedded = local SQLite under .data/fae-memory.db (no Docker Letta; good for M2-1 offline)
# Prefer embedded for local M2-1 without pulling letta/letta; use remote with compose.
# Local default: embedded SQLite. Compose backend overrides to remote.
LETTA_MODE=embedded
LETTA_SERVER_URL=http://localhost:8283
LETTA_AGENT_NAME=fae-main
# LETTA_SERVER_PASSWORD=
# LETTA_EMBEDDED_PATH=.data/fae-memory.db
# Shared hot-window recall (SQLite) + compaction into Qdrant fae_archival
# RECALL_DB_PATH=.data/fae-recall.db
# RECALL_MAX_TURNS=30
# RECALL_COMPACT_BATCH=10
# CORE_CURRENT_CHAR_LIMIT=2000
# ARCHIVAL_PREFER_STUB=false
# ARCHIVAL_DECAY_DAYS=180
# EPISODIC_DB_PATH=.data/fae-episodic.db
# Sleeptime consolidation (idle summarize → core/facts)
# SLEEPTIME_ENABLED=true
# SLEEPTIME_IDLE_SECONDS=300
# SLEEPTIME_POLL_SECONDS=30
# SLEEPTIME_MAX_RUNTIME_S=30
# SLEEPTIME_MIN_INTERVAL_S=60
# SLEEPTIME_DAILY_HOUR=3

# ── vLLM self-hosted (optional — for fully local mode) ───────────────
VLLM_ASR_URL=http://localhost:8001
VLLM_LLM_URL=http://localhost:8002

# ── Vector store ──────────────────────────────────────────────────────
QDRANT_URL=http://localhost:6333

# ── Redis ─────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── CORS (Next.js UI origins, comma-separated) ────────────────────────
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001

# ── Next.js UI (copy into ui/.env.local if needed) ────────────────────
# NEXT_PUBLIC_API_URL=http://localhost:8000
# NEXT_PUBLIC_LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# NEXT_PUBLIC_LLM_MODEL=qwen3-max

# ── Skills (Phase 3) ─────────────────────────────────────────────────
SKILLS_ENABLED=true
# SKILLS_DIR=                 # default: backend/src/skills
# SKILLS_STATE_PATH=.data/fae-skills-state.json
# SKILLS_MAX_ACTIVE=2

# ── Proactive scheduler (Phase 4) — keep false until M4-1 wired ──────
SCHEDULER_ENABLED=false
# HEARTBEAT_SECONDS=30
# OUTREACH_IDLE_HOURS=6
# OUTREACH_COOLDOWN_HOURS=12
# OUTREACH_MAX_PER_DAY=1
# Web Push (optional; generate VAPID keys when enabling notifications)
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:fae@localhost

# ── Daily (optional WebRTC only — not required for local TTS)
DAILY_API_KEY=


# ── Security ──────────────────────────────────────────────────────────
SECRET_KEY=change-me
